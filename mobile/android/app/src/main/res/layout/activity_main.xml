<?xml version="1.0" encoding="utf-8"?>
<!--
  2026-09-14: FrameLayoutをルートに変更(旧: LinearLayout)。理由:
  close_setup_btnをsetup_panel(縦長・スクロール不可のLinearLayout)の
  「先頭の子」として置いていたところ、ユーザー実機で「一番上の無駄な
  パネルをCLOSE出来ないBUG」と報告された——setup_panel自体の描画高さが
  画面を超える場合や、ステータスバーinsetsのtop paddingの影響で、意図した
  位置にボタンが来ない/隠れるケースがあったとみられる。FrameLayoutで
  全体を包み、close/reopenボタンを`layout_gravity="top|end"`の
  オーバーレイとして最前面に固定表示することで、setup_panelの内容量や
  スクロール状態に一切左右されず、常に同じ画面上の位置で押せるようにする。

  android:id="@+id/root_layout": MainActivity.kt側の
  WindowCompat.setDecorFitsSystemWindows(window, false)導入に伴う対応。
  decorFitsSystemWindows(false)によりコンテンツがステータスバー領域まで
  描画されるようになるため、このルートへステータスバー分のtop paddingを
  動的に適用し、既存レイアウトが隠れないようにする(MainActivity.kt側の
  ViewCompat.setOnApplyWindowInsetsListener参照)。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          2026-08-11: 単体動作版へ移行(PCのIPアドレス入力は不要になった)。
          内蔵サーバー起動中/失敗時の状態表示のみを残す(setup_panelという
          ID名は既存レイアウトから引き継ぎ、役割を「接続設定」から
          「起動状態表示」へ変更)。
        -->
        <LinearLayout
            android:id="@+id/setup_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="56dp">

            <!--
              2026-09-14: 上部56dpの余白(paddingTop)は、最前面オーバーレイの
              close_setup_btnと本文の最初の行が重ならないようにするため。
            -->

            <TextView
                android:id="@+id/setup_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_help"
                android:textSize="14sp"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/update_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D6336C"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!--
              2026-08-17追加(ユーザー指示「AIモデルの重みは別途端末内
              ストレージへ配置する必要がある…改善して使いやすくして」への
              対応): モデル重み(distilgpt2+multilingual-e5-small、合計
              約900MB)をHugging Faceから端末内へ直接ダウンロードするボタン。
              これで「サーバーは端末内で起動するが実用的な応答にはモデル
              配置が別途必要」という残っていたギャップを、手動配置ではなく
              アプリ内操作だけで解消できるようにする。
            -->
            <Button
                android:id="@+id/download_model_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/download_model_button" />

            <TextView
                android:id="@+id/download_model_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <!--
              2026-08-19追加(ユーザー指示「モデル重みの保存先と同期バックアップ
              機能をUI上に日英併記で表示して」への対応): モデル重みの内部
              ストレージ保存先を常時表示し、外部ストレージへの手動バックアップ/
              復元操作を提供する。
            -->
            <TextView
                android:id="@+id/model_storage_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/backup_models_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/backup_models_button" />

            <Button
                android:id="@+id/restore_models_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/restore_models_button" />

            <TextView
                android:id="@+id/backup_models_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <!--
              2026-08-19追加(ユーザー指示「使わなくなったスマホもフル動員
              しましょう」バナーの実装、`PhoneAccelWorker.kt`参照): PC側
              aruaru-llmのタスク配布APIへポーリング接続するためのURL入力+
              開始/停止ボタン。
            -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:text="@string/phone_accel_help" />

            <EditText
                android:id="@+id/phone_accel_pc_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/phone_accel_url_hint"
                android:text="http://127.0.0.1:4600"
                android:inputType="textUri" />

            <Button
                android:id="@+id/phone_accel_autodetect_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/phone_accel_autodetect_button" />

            <Button
                android:id="@+id/phone_accel_toggle_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/phone_accel_start_button" />

            <TextView
                android:id="@+id/phone_accel_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>

    <!--
      2026-09-14追加(ユーザー報告「一番上の無駄なパネルをCLOSE出来ない
      BUGだね」への対応): close/reopenいずれも、setup_panelの内容フロー
      から完全に独立したFrameLayoutオーバーレイとして最前面(画面右上、
      常に同じ座標)に固定する。setup_panelがどれだけ長くても、内容が
      何であっても、常にこの位置に表示・タップ可能。
    -->
    <Button
        android:id="@+id/close_setup_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:elevation="16dp"
        android:text="@string/close_setup_panel_button" />

    <Button
        android:id="@+id/reopen_setup_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:elevation="16dp"
        android:text="@string/open_setup_panel_button"
        android:visibility="gone" />

</FrameLayout>
